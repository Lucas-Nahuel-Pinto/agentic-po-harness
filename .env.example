# Atlassian / Jira — required for acli and jira-traceability-manager pulls
ATLASSIAN_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# Xray — optional (xray-cli + Xray widgets); the pipeline degrades gracefully without it
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=

# Tavily — MCP web search
TAVILY_API_KEY=
